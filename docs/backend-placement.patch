+using System;
+using System.Linq;
+using Acoustics.Domain.Entities.Guidebooks._Construction_;
+using Acoustics.Domain.Enums;
+using FluentAssertions;
+using Xunit;
+
+namespace UnitTests.PlacementTests;
+
+/// <summary>
+/// Проверяет признак активного платного размещения — общий ключ сортировки выдач
+/// (вариант «а»: оплата поднимает конструкцию только при прочих равных).
+/// </summary>
+public class ConstructionPlacementPolicyTests
+{
+    [Fact]
+    public void IsPlacementActive_FutureDate_ShouldBeTrue()
+    {
+        var header = new ConstructionHeader { PaidPlacementUntil = DateTime.UtcNow.AddDays(1) };
+
+        ConstructionPlacementPolicy.IsPlacementActive.Compile()(header).Should().BeTrue();
+    }
+
+    [Fact]
+    public void IsPlacementActive_Null_ShouldBeFalse()
+    {
+        var header = new ConstructionHeader { PaidPlacementUntil = null };
+
+        ConstructionPlacementPolicy.IsPlacementActive.Compile()(header).Should().BeFalse();
+    }
+
+    [Fact]
+    public void IsPlacementActive_PastDate_ShouldBeFalse()
+    {
+        var header = new ConstructionHeader { PaidPlacementUntil = DateTime.UtcNow.AddDays(-1) };
+
+        ConstructionPlacementPolicy.IsPlacementActive.Compile()(header).Should().BeFalse();
+    }
+
+    [Fact]
+    public void SortByPriorityThenPlacement_PaidWithinSamePriorityGoesFirst_UnpaidHigherPriorityStaysFirst()
+    {
+        var now = DateTime.UtcNow;
+        var unpaidPriority8 = new ConstructionHeader { Name = "unpaid-8", Priority = Priority.Eight, PaidPlacementUntil = null };
+        var paidPriority5 = new ConstructionHeader { Name = "paid-5", Priority = Priority.Five, PaidPlacementUntil = now.AddDays(30) };
+        var unpaidPriority5 = new ConstructionHeader { Name = "unpaid-5", Priority = Priority.Five, PaidPlacementUntil = null };
+        var expiredPriority5 = new ConstructionHeader { Name = "expired-5", Priority = Priority.Five, PaidPlacementUntil = now.AddDays(-1) };
+        var items = new[] { unpaidPriority5, expiredPriority5, unpaidPriority8, paidPriority5 };
+
+        var isActive = ConstructionPlacementPolicy.IsPlacementActive.Compile();
+        var sorted = items
+            .OrderByDescending(x => x.Priority)
+            .ThenByDescending(isActive)
+            .Select(x => x.Name)
+            .ToList();
+
+        // Оплаченная поднялась выше неоплаченных в своей группе приоритета (Five),
+        // но не выше конструкции с приоритетом Eight (вариант «а»); истёкшая дата = не оплачено.
+        sorted.Should().Equal("unpaid-8", "paid-5", "unpaid-5", "expired-5");
+    }
+}
