@@ -0,0 +1,25 @@
+using Acoustics.Domain.Entities.Abstractions;
+using Acoustics.Domain.Enums;
+
+namespace Acoustics.Domain.Entities.Guidebooks._Construction_;
+
+/// <summary>
+/// Факт взаимодействия с карточкой конструкции в каталоге: клик по ссылке производителя
+/// или скачивание документа. Записи append-only (не редактируются и не удаляются),
+/// служат источником статистики платных размещений.
+/// </summary>
+public class PlacementInteraction : BaseEntity
+{
+    public Guid ConstructionHeaderId { get; set; }
+
+    public PlacementInteractionType Type { get; set; }
+
+    /// <summary>Момент события (UTC, ставится сервером — клиентскому времени не доверяем).</summary>
+    public DateTime OccurredAtUtc { get; set; }
+
+    /// <summary>Пользователь, выполнивший действие; null для анонимных посетителей каталога.</summary>
+    public Guid? UserId { get; set; }
+
+    /// <summary>Полная UTM-query ссылки производителя (utm_source=devbim&utm_medium=catalog&utm_content=…).</summary>
+    public string? Utm { get; set; }
+}
