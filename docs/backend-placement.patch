diff --git a/src/Acoustics.Application/UseCases/Guidebooks/_Placement_/Command/CreatePlacementInteractionUseCase.cs b/src/Acoustics.Application/UseCases/Guidebooks/_Placement_/Command/CreatePlacementInteractionUseCase.cs
