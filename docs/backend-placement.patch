@@ -0,0 +1,58 @@
+using Acoustics.Application.Abstractions.Contexts;
+using Acoustics.Application.Abstractions.Repositories;
+using Acoustics.Application.Abstractions.Repositories.Guidebooks;
+using Acoustics.Application.Models;
+using Acoustics.Domain;
+using Acoustics.Domain.Entities.Guidebooks._Construction_;
+using Acoustics.Domain.Enums;
+using MediatR;
+
+namespace Acoustics.Application.UseCases.Guidebooks._Placement_.Command;
+
+public record CreatePlacementInteractionCommand : IRequest<Result>
+{
+    public Guid ConstructionHeaderId { get; init; }
+
+    public PlacementInteractionType Type { get; init; }
+
+    /// <summary>Полная UTM-query ссылки производителя (utm_source=devbim&utm_medium=catalog&utm_content=…).</summary>
+    public string? Utm { get; init; }
+}
+
+/// <summary>
+/// Фиксирует взаимодействие с карточкой конструкции в каталоге (клик по ссылке производителя,
+/// скачивание документа). Вызывается фронтом fire-and-forget анонимно; если конструкция не существует,
+/// событие молча отбрасывается, чтобы не раскрывать существование идентификаторов и не мешать переходу.
+/// </summary>
+public class CreatePlacementInteractionUseCase(
+    IConstructionHeaderRepository constructionHeaderRepository,
+    IPlacementInteractionRepository placementInteractionRepository,
+    IAuthenticatedContext authenticatedContext,
+    IUnitOfWork unitOfWork)
+    : IRequestHandler<CreatePlacementInteractionCommand, Result>
+{
+    public async Task<Result> Handle(CreatePlacementInteractionCommand request, CancellationToken cancellationToken)
+    {
+        var constructionExists = await constructionHeaderRepository
+            .IsExistsAsync(x => x.Id == request.ConstructionHeaderId, cancellationToken);
+
+        if (!constructionExists)
+        {
+            return Result.Success();
+        }
+
+        var interaction = new PlacementInteraction
+        {
+            ConstructionHeaderId = request.ConstructionHeaderId,
+            Type = request.Type,
+            OccurredAtUtc = DateTime.UtcNow,
+            UserId = authenticatedContext.IsAuthenticated ? authenticatedContext.UserId : null,
+            Utm = request.Utm,
+        };
+
+        placementInteractionRepository.Create(interaction);
+        await unitOfWork.SaveChangesAsync(cancellationToken);
+
+        return Result.Success();
+    }
+}
