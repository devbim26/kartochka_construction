+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Acoustics.Application.UseCases.Guidebooks._Placement_.Query;
+using Acoustics.Domain.Entities.Guidebooks._Construction_;
+using Acoustics.Domain.Enums;
+using FluentAssertions;
+using Xunit;
+
+namespace UnitTests.PlacementTests;
+
+public class PlacementStatsAggregatorTests
+{
+    private static readonly Guid HeaderA = Guid.Parse("c1f2a3b4-0001-4000-8000-0000000000a1");
+    private static readonly Guid HeaderB = Guid.Parse("c1f2a3b4-0001-4000-8000-0000000000b2");
+    private static readonly Guid User1 = Guid.Parse("00000000-0000-0000-0000-000000000001");
+    private static readonly Guid User2 = Guid.Parse("00000000-0000-0000-0000-000000000002");
+
+    [Fact]
+    public void Aggregate_2SiteClicks1DownloadFrom2Users_ShouldCountClicksDownloadsAndUniqueUsers()
+    {
+        var interactions = new List<PlacementInteraction>
+        {
+            new() { ConstructionHeaderId = HeaderA, Type = PlacementInteractionType.SiteClick, UserId = User1 },
+            new() { ConstructionHeaderId = HeaderA, Type = PlacementInteractionType.SiteClick, UserId = User2 },
+            new() { ConstructionHeaderId = HeaderA, Type = PlacementInteractionType.DocumentDownload, UserId = User1 },
+        };
+
+        var stats = PlacementStatsAggregator.Aggregate(interactions);
+
+        stats.Should().HaveCount(1);
+        var row = stats[0];
+        row.ConstructionHeaderId.Should().Be(HeaderA);
+        row.SiteClicks.Should().Be(2);
+        row.DocumentDownloads.Should().Be(1);
+        row.UniqueUsers.Should().Be(2);
+    }
+
+    [Fact]
+    public void Aggregate_TwoConstructions_ShouldGroupByConstructionHeader()
+    {
+        var interactions = new List<PlacementInteraction>
+        {
+            new() { ConstructionHeaderId = HeaderA, Type = PlacementInteractionType.SiteClick, UserId = User1 },
+            new() { ConstructionHeaderId = HeaderB, Type = PlacementInteractionType.DocumentDownload, UserId = User1 },
+            new() { ConstructionHeaderId = HeaderB, Type = PlacementInteractionType.DocumentDownload, UserId = null },
+        };
+
+        var stats = PlacementStatsAggregator.Aggregate(interactions);
+
+        stats.Should().HaveCount(2);
+        stats.Single(x => x.ConstructionHeaderId == HeaderA).SiteClicks.Should().Be(1);
+        var b = stats.Single(x => x.ConstructionHeaderId == HeaderB);
+        b.DocumentDownloads.Should().Be(2);
+        b.UniqueUsers.Should().Be(1);
+    }
+
+    [Fact]
+    public void Aggregate_AnonymousOnly_ShouldCountEventsWithoutUsers()
+    {
+        var interactions = new List<PlacementInteraction>
+        {
+            new() { ConstructionHeaderId = HeaderA, Type = PlacementInteractionType.SiteClick, UserId = null },
+            new() { ConstructionHeaderId = HeaderA, Type = PlacementInteractionType.SiteClick, UserId = null },
+        };
+
+        var stats = PlacementStatsAggregator.Aggregate(interactions);
+
+        stats.Single().SiteClicks.Should().Be(2);
+        stats.Single().UniqueUsers.Should().Be(0);
+    }
+
+    [Fact]
+    public void Aggregate_EmptyList_ShouldReturnEmptyList()
+    {
+        PlacementStatsAggregator.Aggregate(Enumerable.Empty<PlacementInteraction>())
+            .Should().BeEmpty();
+    }
+}
