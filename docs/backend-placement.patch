@@ -1,3 +1,4 @@
+using Acoustics.Application.Common.Extensions;
 using Acoustics.Domain.Constants.Guidebooks;
 using Acoustics.Domain.Entities.Guidebooks._Construction_;
 using Acoustics.Domain.Enums;
@@ -72,4 +73,30 @@ public class AlternativeConstructionHeaderQueryBuilder(IQueryable<ConstructionHe
 
         return this;
     }
+
+    /// <summary>
+    /// Сортировка альтернативных конструкций: сначала явная сортировка (если задана),
+    /// затем оплаченные размещения поднимаются выше неоплаченных при прочих равных (вариант «а»).
+    /// Без явной сортировки признак оплаты становится первичным ключом сортировки.
+    /// </summary>
+    public AlternativeConstructionHeaderQueryBuilder OrderByWithPlacementBoost(string? ordering, SortOrder sortOrder)
+    {
+        if (!string.IsNullOrEmpty(ordering))
+        {
+            var ordered = sortOrder == SortOrder.Asc
+                ? _query.OrderBy(ordering)
+                : _query.OrderByDescending(ordering);
+
+            // Строковый OrderBy возвращает IQueryable<T>, но в рантайме это уже
+            // упорядоченный запрос EF, поэтому каст к IOrderedQueryable корректен.
+            _query = ((IOrderedQueryable<ConstructionHeader>)ordered)
+                .ThenByDescending(ConstructionPlacementPolicy.IsPlacementActive);
+        }
+        else
+        {
+            _query = _query.OrderByDescending(ConstructionPlacementPolicy.IsPlacementActive);
+        }
+
+        return this;
+    }
 }
