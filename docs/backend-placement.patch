+using Acoustics.Domain.Entities.Guidebooks._Construction_;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Metadata.Builders;
+
+namespace Acoustics.Infrastructure.Database.EntityConfigurations.Guidebooks._Construction_;
+
+public class PlacementInteractionConfig : IEntityTypeConfiguration<PlacementInteraction>
+{
+    public void Configure(EntityTypeBuilder<PlacementInteraction> builder)
+    {
+        builder.ToTable(nameof(PlacementInteraction));
+        builder.HasKey(x => x.Id);
+
+        builder.HasOne<ConstructionHeader>()
+            .WithMany()
+            .HasForeignKey(x => x.ConstructionHeaderId)
+            .OnDelete(DeleteBehavior.Cascade);
+
+        builder.Property(x => x.OccurredAtUtc)
+            .HasColumnType("timestamptz");
+
+        builder.HasIndex(x => new { x.ConstructionHeaderId, x.OccurredAtUtc })
+            .HasDatabaseName("IX_PlacementInteraction_Header_OccurredAtUtc");
+    }
+}
