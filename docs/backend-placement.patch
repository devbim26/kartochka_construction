+using Acoustics.API.Controllers.Abstraction;
+using Acoustics.Application.Models.Dto.Guidebooks.Placements;
+using Acoustics.Application.UseCases.Guidebooks._Placement_.Command;
+using Acoustics.Application.UseCases.Guidebooks._Placement_.Query;
+using MediatR;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+
+namespace Acoustics.API.Controllers.Guidebooks;
+
+/// <summary>
+/// Счётчики платных размещений: фиксация взаимодействий с карточками каталога
+/// и статистика для администратора.
+/// </summary>
+public class PlacementController(ISender sender) : RestApiController(sender)
+{
+    /// <summary>
+    /// Фиксирует взаимодействие с карточкой конструкции (клик по ссылке производителя,
+    /// скачивание документа). Фронт вызывает fire-and-forget: анонимно, переход не ждёт ответа.
+    /// Неизвестная конструкция обрабатывается успешно (событие отбрасывается).
+    /// </summary>
+    [AllowAnonymous]
+    [HttpPost("interaction")]
+    [ProducesResponseType(StatusCodes.Status200OK)]
+    public async Task<IActionResult> RegisterInteraction(CreatePlacementInteractionCommand command)
+    {
+        var result = await _sender.Send(command, HttpContext.RequestAborted);
+
+        return ToActionResult(result);
+    }
+
+    /// <summary>Агрегаты взаимодействий за период по конструкциям (клики, скачивания, уникальные пользователи).</summary>
+    [Authorize(Policy = "RequireAdmin")]
+    [HttpGet("stats")]
+    [ProducesResponseType(typeof(List<PlacementStatsDto>), StatusCodes.Status200OK)]
+    public async Task<IActionResult> GetStats(
+        [FromQuery] DateTime fromUtc,
+        [FromQuery] DateTime toUtc,
+        [FromQuery] Guid? constructionHeaderId)
+    {
+        var result = await _sender.Send(new GetPlacementStatsQuery
+        {
+            FromUtc = fromUtc,
+            ToUtc = toUtc,
+            ConstructionHeaderId = constructionHeaderId,
+        }, HttpContext.RequestAborted);
+
+        return ToActionResult(result);
+    }
+}
