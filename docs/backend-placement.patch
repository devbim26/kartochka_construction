@@ -0,0 +1,18 @@
+using System.Linq.Expressions;
+
+namespace Acoustics.Domain.Entities.Guidebooks._Construction_;
+
+/// <summary>
+/// Признак активного платного размещения, общий для сортировок выдачи (вариант «а»:
+/// оплата поднимает конструкцию только при прочих равных, внутри одной группы приоритета).
+/// Используется в query builders сортировки и в юнит-тестах.
+/// </summary>
+public static class ConstructionPlacementPolicy
+{
+    /// <summary>
+    /// Размещение оплачено и активно: дата окончания ещё в будущем.
+    /// Для NULL (не оплачено) сравнение даёт false и в SQL, и в памяти.
+    /// </summary>
+    public static readonly Expression<Func<ConstructionHeader, bool>> IsPlacementActive =
+        x => x.PaidPlacementUntil > DateTime.UtcNow;
+}
