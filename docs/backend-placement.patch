diff --git a/src/Acoustics.Infrastructure/Repositories/Guidebooks/PlacementInteractionRepository.cs b/src/Acoustics.Infrastructure/Repositories/Guidebooks/PlacementInteractionRepository.cs
new file mode 100644
index 0000000..703f6ed
--- /dev/null
+++ b/src/Acoustics.Infrastructure/Repositories/Guidebooks/PlacementInteractionRepository.cs
@@ -0,0 +1,32 @@
+using System.Linq.Expressions;
+using Acoustics.Application.Abstractions.Repositories.Guidebooks;
+using Acoustics.Domain.Entities.Guidebooks._Construction_;
+using Acoustics.Infrastructure.Database;
+using Acoustics.Infrastructure.Repositories.Abstract;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acoustics.Infrastructure.Repositories.Guidebooks;
+
+public class PlacementInteractionRepository(AppDbContext dbContext)
+    : CrudRepository<PlacementInteraction>(dbContext), IPlacementInteractionRepository
+{
+    protected override IEnumerable<Expression<Func<PlacementInteraction, object>>> Includes => [];
+
+    public Task<List<PlacementInteraction>> GetForPeriodAsync(
+        DateTime fromUtc,
+        DateTime toUtc,
+        Guid? constructionHeaderId = null,
+        CancellationToken cancellationToken = default)
+    {
+        var query = _dbContext.Set<PlacementInteraction>().AsNoTracking();
+
+        query = query.Where(x => x.OccurredAtUtc >= fromUtc && x.OccurredAtUtc < toUtc);
+
+        if (constructionHeaderId.HasValue)
+        {
+            query = query.Where(x => x.ConstructionHeaderId == constructionHeaderId.Value);
+        }
+
+        return query.ToListAsync(cancellationToken);
+    }
+}
diff --git a/src/Acoustics.Infrastructure/Repositories/QueryBuilders/Guidebooks/AlternativeConstructionHeaderQueryBuilder.cs b/src/Acoustics.Infrastructure/Repositories/QueryBuilders/Guidebooks/AlternativeConstructionHeaderQueryBuilder.cs
