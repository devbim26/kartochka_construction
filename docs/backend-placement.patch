+using Acoustics.Application.Abstractions.Repositories.Guidebooks;
+using Acoustics.Application.Models;
+using Acoustics.Application.Models.Dto.Guidebooks.Placements;
+using Acoustics.Domain;
+using MediatR;
+
+namespace Acoustics.Application.UseCases.Guidebooks._Placement_.Query;
+
+public record GetPlacementStatsQuery : IRequest<Result<List<PlacementStatsDto>>>
+{
+    /// <summary>Начало периода (UTC, включительно).</summary>
+    public DateTime FromUtc { get; init; }
+
+    /// <summary>Конец периода (UTC, не включается).</summary>
+    public DateTime ToUtc { get; init; }
+
+    /// <summary>Опциональный отбор по одной конструкции.</summary>
+    public Guid? ConstructionHeaderId { get; init; }
+}
+
+/// <summary>
+/// Возвращает агрегаты взаимодействий с размещениями за период: клики по ссылкам производителя,
+/// скачивания документов и уникальные пользователи по каждой конструкции. Доступ — только админ.
+/// </summary>
+public class GetPlacementStatsUseCase(IPlacementInteractionRepository placementInteractionRepository)
+    : IRequestHandler<GetPlacementStatsQuery, Result<List<PlacementStatsDto>>>
+{
+    public async Task<Result<List<PlacementStatsDto>>> Handle(GetPlacementStatsQuery request, CancellationToken cancellationToken)
+    {
+        var interactions = await placementInteractionRepository.GetForPeriodAsync(
+            request.FromUtc, request.ToUtc, request.ConstructionHeaderId, cancellationToken);
+
+        return Result<List<PlacementStatsDto>>.Success(PlacementStatsAggregator.Aggregate(interactions));
+    }
+}
diff --git a/src/Acoustics.Application/UseCases/Guidebooks/_Placement_/Query/PlacementStatsAggregator.cs b/src/Acoustics.Application/UseCases/Guidebooks/_Placement_/Query/PlacementStatsAggregator.cs
new file mode 100644
index 0000000..86285cc
--- /dev/null
+++ b/src/Acoustics.Application/UseCases/Guidebooks/_Placement_/Query/PlacementStatsAggregator.cs
@@ -0,0 +1,30 @@
+using Acoustics.Application.Models.Dto.Guidebooks.Placements;
+using Acoustics.Domain.Entities.Guidebooks._Construction_;
+using Acoustics.Domain.Enums;
+
+namespace Acoustics.Application.UseCases.Guidebooks._Placement_.Query;
+
+/// <summary>
+/// Считает агрегаты взаимодействий с размещениями по конструкциям: клики по ссылкам производителя,
+/// скачивания документов, уникальные пользователи. Чистая функция — покрывается юнит-тестами.
+/// </summary>
+public static class PlacementStatsAggregator
+{
+    public static List<PlacementStatsDto> Aggregate(IEnumerable<PlacementInteraction> interactions)
+    {
+        return interactions
+            .GroupBy(x => x.ConstructionHeaderId)
+            .Select(g => new PlacementStatsDto
+            {
+                ConstructionHeaderId = g.Key,
+                SiteClicks = g.Count(x => x.Type == PlacementInteractionType.SiteClick),
+                DocumentDownloads = g.Count(x => x.Type == PlacementInteractionType.DocumentDownload),
+                UniqueUsers = g.Where(x => x.UserId.HasValue)
+                    .Select(x => x.UserId!.Value)
+                    .Distinct()
+                    .Count(),
+            })
+            .OrderByDescending(x => x.SiteClicks + x.DocumentDownloads)
+            .ToList();
+    }
+}
